# This .gitignore file should be placed at the root of your Unity project directory

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Pp]ackages/
[Cc]rash[Rr]eports/

# Never ignore Asset meta files
![Aa]ssets/**/*.meta

# Ignore project settings except the manifest
[Pp]rojectSettings/*
![Pp]rojectSettings/Packages/

# Autogenerated files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta

# Builds
*.apk
*.aab
*.unitypackage

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vs/
.vscode/
.idea/

# Asset Store tools
AssetStoreTools*
